pkgbase = openchamber-bin
	pkgdesc = Desktop app for OpenChamber, the agentic development environment (official prebuilt release)
	pkgver = 2.6.0
	pkgrel = 1
	url = https://openchamber.dev
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = 7zip
